; Native replacement engine foundation. Original content stays outside res://.
config_version=5

[application]
config/name="GoF2 Remake"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="gof2-remake"
config/features=PackedStringArray("4.4", "Mobile")

[display]
window/size/viewport_width=1120
window/size/viewport_height=720
window/size/window_width_override=1120
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true
window/handheld/orientation=0

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.windows="vulkan"
rendering_device/driver.linuxbsd="vulkan"
rendering_device/driver.macos="metal"
rendering_device/fallback_to_opengl3=true
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.065, 1)
