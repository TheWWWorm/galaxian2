static func parameters(data: Variant) -> bool:
	return Equal.equal_value(data,VALUES) or Equal.equal_value(data,MAC_VALUES)

## Detached world-component selection; campaign and portal admission remain
## with their native owners. Scenery and population share this boundary.
static func selected_void(travel: Dictionary,context: Dictionary) -> bool:
	if not parameters(travel.get("void_crystals")) or not VoidAccess.parameters(travel.get("void_access")):return false
	var portal: Dictionary=travel.void_access.ordinary_portal
	var expected:={"campaign_cursor":int(travel.void_crystals.mission33.campaign_cursor),
		"selected_system_id":int(portal.selected_void_system_id),"selected_station_id":int(portal.selected_void_station_id),
		"retained_system_id":int(portal.retained_void_system_id),"retained_station_id":int(portal.retained_void_station_id),
		"selected_mission_kind":int(portal.selected_mission_kind_at_source_flight)}
	for key in expected:
		if not context.get(key) is int or context[key]!=expected[key]:return false
	return context.get("selected_mission_story") is bool and context.selected_mission_story==portal.selected_mission_story_at_source_flight and context.get("location_match") is bool and context.location_match

static func shared_field(population: Variant, resources: Variant) -> bool:
	if not population is Dictionary or not resources is Dictionary:return false
	return Equal.equal_value(population.get("count_base"),80) \
		and Equal.equal_value(population.get("count_bound"),80) \
		and population.get("provenance") is Dictionary and population.provenance.size()==6 \
		and Equal.equal_value(resources.get("ore_item_ids"),[154,155,156,157,158,159,160,161,162,163]) \
		and Equal.equal_value(resources.get("fallback_item_id"),164) \
		and Equal.equal_value(resources.get("location_weight"),100) \
		and Equal.equal_value(resources.get("model_ids"),[16900,16921,16904,18836]) \
		and Equal.equal_value(resources.get("override_cursor"),90) \
		and resources.get("provenance") is Dictionary and resources.provenance.size()==12

static func validate(data: Variant, proof: Variant, executable_bytes: int, architecture: String, arrival: Dictionary, visits: Variant, population: Variant, resources: Variant) -> String:
	if not parameters(data):return "Unsupported Void crystal declarations"
	if architecture!="x86_64":return "Unsupported Void crystal source architecture"
	var app_store: bool=Equal.equal_value(data,VALUES)
	if not Equal.equal_value(visits,PostProbe.VALUES if app_store else PostProbe.MAC_VALUES):return "Disconnected cursor33 station declaration"
	if not shared_field(population,resources):return "Disconnected Void crystal scenery declarations"
	var origin: Variant=arrival.get("provenance",{}).get("actor")
	if not Fonts.extent(origin,"offset","bytes",[315],executable_bytes):return "Void crystal source anchor is missing"
	return "" if Layouts.matches(proof,int(origin.offset),executable_bytes,[SPANS if app_store else MAC_SPANS]) else "Disconnected Void crystal source declaration"
