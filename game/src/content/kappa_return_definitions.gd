static func parameters(data: Variant) -> bool:return Equal.equal_value(data,VALUES) or Equal.equal_value(data,MAC_VALUES)

static func available(bindings: RefCounted) -> bool:
	return bindings!=null and parameters(bindings.mido_travel.get("kappa_return"))

static func conversation(bindings: RefCounted,cursor: Variant,mission: Variant) -> Dictionary:
	if not available(bindings) or not cursor is int:return {}
	for rules in bindings.mido_travel.kappa_return.conversations:
		if cursor==int(rules.campaign_cursor) and Equal.equal_value(mission,rules.mission):return rules.duplicate(true)
	return {}

static func selected(travel: Dictionary,context: Dictionary) -> bool:
	if not parameters(travel.get("kappa_return")) or context.get("mission_story")!=true or context.get("mission_completed")!=false:return false
	for rules in travel.kappa_return.conversations:
		if context.get("campaign_cursor")==int(rules.campaign_cursor) and context.get("system_id")==int(rules.system_id) and context.get("station_id")==int(rules.mission.station_id) and context.get("mission_kind")==int(rules.mission.kind):return true
	return false

static func briefing(travel: Dictionary,context: Dictionary) -> Array:
	if not selected(travel,context):return []
	var rules: Dictionary=travel.kappa_return.arrival_briefing
	return rules.events.duplicate(true) if context.campaign_cursor==int(rules.campaign_cursor) else []
