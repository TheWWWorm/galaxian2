# Native composition.
static func parameters(data: Variant) -> bool:
	return Equal.equal_value(data, VALUES) or Equal.equal_value(data, MAC_VALUES)

static func validate(data: Variant, provenance: Variant, executable_bytes: int, architecture: String, arrival: Dictionary) -> String:
	if data is Dictionary and data.is_empty():
		return "" if provenance is Dictionary and provenance.is_empty() else "Unexpected Sahi encounter provenance"
	if architecture != "x86_64" or not parameters(data):return "Unsupported Sahi encounter declarations"
	var source: Variant = arrival.get("provenance")
	if not source is Dictionary:return "Sahi encounter lacks its staging anchor"
	var anchor: Variant = source.get("actor")
	if not Fonts.extent(anchor, "offset", "bytes", [315], executable_bytes):return "Sahi encounter lacks its staging anchor"
	var spans: Dictionary = SPANS if Equal.equal_value(data, VALUES) else MAC_SPANS
	return "" if Layouts.matches(provenance, int(anchor.offset), executable_bytes, [spans]) else "Disconnected Sahi encounter declarations"

static func coherent(travel: Dictionary) -> bool:
	var encounter: Variant = travel.get("sahi_encounter")
	var visit: Variant = travel.get("sahi_visit")
	return (Equal.equal_value(encounter, VALUES) and Equal.equal_value(visit, Visit.VALUES)) or (Equal.equal_value(encounter, MAC_VALUES) and Equal.equal_value(visit, Visit.MAC_VALUES))

static func selected(travel: Dictionary, context: Dictionary) -> bool:
	return coherent(travel) and Visit.selected(travel, context)

## Detached declarations for existing population and radio owners. This query
## neither constructs a world nor changes which campaign missions are playable.
static func declarations(travel: Dictionary, context: Dictionary) -> Dictionary:
	return travel.sahi_encounter.duplicate(true) if selected(travel, context) else {}

static func actors(travel: Dictionary, context: Dictionary) -> Array:
	return travel.sahi_encounter.population.actors.duplicate(true) if selected(travel, context) else []

static func radio_events(travel: Dictionary, context: Dictionary) -> Array:
	return travel.sahi_encounter.radio_events.duplicate(true) if selected(travel, context) else []

## Derived world-effect composition for the already-selected encounter. This
## does not authorize cursor24 navigation or a later campaign transition.
static func initialization(bindings: RefCounted, context: Dictionary) -> Dictionary:
	var later=load("res://src/content/post_sahi_definitions.gd")
	var post: bool=bindings!=null and later.selected(bindings.mido_travel,context)
	var dima: bool=bindings!=null and Dima.selected(bindings.mido_travel,context)
	if bindings==null or not (post or dima or selected(bindings.mido_travel,context)):return {}
	var shared: Dictionary=bindings.opening_actors.get("npc_initialization",{}).get("world_initialization",{})
	if not WorldInitialization.parameters(shared):return {}
	var ordinary:=World.impact_model(bindings,0)
	if ordinary<0:return {}
	var data: Dictionary=later.population(bindings.mido_travel,context) if post else (Dima.population(bindings.mido_travel,context) if dima else bindings.mido_travel.sahi_encounter.population.duplicate(true))
	if data.is_empty():return {}
	for key in ["weapon_effect_capacity","weapon_effect_random_bound","zero_means_flipped"]:data[key]=shared[key]
	var source: Dictionary=bindings.mido_travel.sahi_encounter.weapons["void"]
	data.weapon_groups=["fighter"];data.weapon_item_sequence=[];data.weapon_effect_sequence=[]
	data.faction_weapon_effects={int(source.actor_kind):{"items":[0,int(source.item_id)],"resources":[ordinary,int(source.impact_model_id)]}}
	return data
