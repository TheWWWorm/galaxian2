static func parameters(data: Variant) -> bool:
	return data is Dictionary and (Equal.equal_value(data,VALUES) or Equal.equal_value(data,MAC_VALUES))

## Resolve a source station result. The campaign owner admits playable cases.
static func conversation(bindings: RefCounted,cursor: Variant,mission: Variant) -> Dictionary:
	if bindings==null or not cursor is int or cursor not in [31,32] or not parameters(bindings.mido_travel.get("post_probe_visits")):return {}
	var data: Dictionary=bindings.mido_travel.post_probe_visits
	var source: Dictionary=data.missions[str(cursor)]
	var expected:=mission_values(source)
	if not Equal.equal_value(mission,expected):return {}
	var completion: Dictionary=source.completion
	var next_cursor:=int(completion.advance_on_final_next_to_cursor)
	var next_source: Dictionary=data.missions[str(next_cursor)] if data.missions.has(str(next_cursor)) else data.next_mission
	return {"campaign_cursor":cursor,"system_id":int(source.system_id),"mission":expected,
		"target_station_required":completion.requires_landed_target,"events":source.result_events.duplicate(true),
		"next_cursor":next_cursor,"next_mission":mission_values(next_source),"reward_credits":int(completion.reward_credits)}

static func mission_values(source: Dictionary) -> Dictionary:
	var result:={}
	for key in ["kind","station_id","reward","bonus"]:result[key]=int(source[key])
	result.source_parameter=int(source.get("source_parameter",0))
	return result
