## Cargo owners may retain pickup markers and the separately earned Sahi story
## marker. This query does not mark a row or change the tractor transfer rules.
static func cargo_marker_ids(bindings: RefCounted) -> Array:
	if not available(bindings):return []
	var result: Array=bindings.mido_travel.tractor_recovery.transfer.special_item_ids.map(func(id):return int(id))
	if load("res://src/content/post_sahi_definitions.gd").available(bindings) and load("res://src/content/sahi_stage_definitions.gd").coherent(bindings.mido_travel):
		result.append(int(bindings.mido_travel.sahi_stage.next_factory.protected_cargo_item_id))
	return result
