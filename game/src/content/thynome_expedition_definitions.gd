static func parameters(data: Variant) -> bool:
	return Equal.equal_value(data,VALUES) or Equal.equal_value(data,MAC_VALUES)

static func coherent(travel: Dictionary) -> bool:
	return Post.parameters(travel.get("post_sahi",{})) and parameters(travel.get("thynome_expedition",{}))

static func available(bindings: RefCounted) -> bool:
	return bindings!=null and coherent(bindings.mido_travel)

## Preparing this station result does not admit navigation or advance a career.
static func conversation(bindings: RefCounted,cursor: Variant,mission: Variant) -> Dictionary:
	if not available(bindings) or cursor!=27 or not Equal.equal_value(mission,Post.active_mission(bindings,27)):return {}
	var data: Dictionary=bindings.mido_travel.thynome_expedition
	var rule: Dictionary=data.station_ack
	return {"campaign_cursor":int(rule.campaign_cursor),"system_id":6,
		"mission":Post.active_mission(bindings,27),"target_station_required":true,
		"events":bindings.mido_travel.post_sahi.missions["27"].result_events.duplicate(true),
		"next_cursor":int(rule.advance_on_final_next_to_cursor),
		"next_mission":mission_values(data.mission28),"reward_credits":int(rule.reward_credits)}

static func mission_values(source: Dictionary) -> Dictionary:
	var result:={}
	for key in ["kind","station_id","reward","bonus","source_parameter"]:result[key]=int(source[key])
	return result
